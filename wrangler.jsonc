{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openvaultdb-com",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "openvaultdb.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
